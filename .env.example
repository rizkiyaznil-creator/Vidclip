# ─── Backend ───────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true

# ─── Database (PostgreSQL) ─────────────────────────────────
POSTGRES_USER=vidclip
POSTGRES_PASSWORD=vidclip
POSTGRES_DB=vidclip
# Dipakai backend untuk konek (host 'postgres' saat di docker-compose)
DATABASE_URL=postgresql+psycopg://vidclip:vidclip@postgres:5432/vidclip

# ─── Redis (broker antrian Celery) ─────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Object Storage (MinIO untuk dev, S3/R2 untuk prod) ────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=vidclip
S3_REGION=us-east-1
# true untuk MinIO (path-style), false untuk S3/R2 sungguhan
S3_USE_PATH_STYLE=true

# ─── Keamanan ──────────────────────────────────────────────
# Kunci untuk menandatangani JWT (ganti di produksi!)
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080
# Master key Fernet untuk enkripsi API key user.
# Generate dengan:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=change-me-generate-a-real-fernet-key
